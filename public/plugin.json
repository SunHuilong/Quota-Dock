{
  "pluginName": "Quota Dock - AI额度看板",
  "description": "Quota Dock 用于集中查询和监控 AI API 平台的账户余额与套餐额度。\n\n支持平台\nDeepSeek\nKimi\n阶跃星辰 StepFun\n硅基流动 SiliconFlow\n302.AI\nNovita AI\nOpenRouter\nMiniMax Token Plan\n智谱 GLM Coding Plan\nZ.AI Coding Plan\nxAI / Grok\nOpenAI Organization\nAnthropic Organization\nAIHubMix\n\n支持查询\n账户余额\n总额度与已用额度\nCoding Plan 套餐额度\n额度重置时间\n多货币余额汇总\n\n主要功能\n集中管理官方平台与中转站\n支持自定义 Base URL、API Key、请求参数和 JSON 字段映射\n自动刷新余额与额度\n桌面浮窗实时监控\n通过 uTools MCP 向 AI Agent 提供安全的额度查询、健康检查和浮窗控制能力",
  "author": "Codex",
  "homepage": "",
  "version": "0.2.0",
  "logo": "logo.png",
  "main": "index.html",
  "preload": "preload.js",
  "pluginSetting": {
    "height": 520
  },
  "tools": {
    "quota_overview": {
      "description": "刷新全部已配置站点，并返回不含凭证和请求配置的额度总览、状态统计及按币种汇总。单个站点失败不会中断其他站点。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generatedAt": { "type": "string" },
          "providerCount": { "type": "integer", "minimum": 0 },
          "configuredCount": { "type": "integer", "minimum": 0 },
          "statusCounts": { "$ref": "#/$defs/statusCounts" },
          "totalsByUnit": {
            "type": "array",
            "items": { "$ref": "#/$defs/unitTotal" }
          },
          "providers": {
            "type": "array",
            "items": { "$ref": "#/$defs/providerSummary" }
          },
          "refresh": { "$ref": "#/$defs/refreshBatch" }
        },
        "required": [
          "generatedAt",
          "providerCount",
          "configuredCount",
          "statusCounts",
          "totalsByUnit",
          "providers",
          "refresh"
        ],
        "additionalProperties": false,
        "$defs": {
          "safeError": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing_credential",
                  "preset_unavailable",
                  "refresh_failed",
                  "not_checked",
                  "stale",
                  "low_remaining"
                ]
              },
              "message": { "type": "string" }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          },
          "meter": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["balance", "quota", "spend"] },
              "remaining": { "type": ["number", "null"] },
              "used": { "type": ["number", "null"] },
              "limit": { "type": ["number", "null"] },
              "unit": { "type": "string" },
              "resetAt": { "type": ["string", "null"] },
              "remainingPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "aggregate": { "type": "boolean" }
            },
            "required": [
              "id",
              "label",
              "kind",
              "remaining",
              "used",
              "limit",
              "unit",
              "resetAt",
              "remainingPercent",
              "aggregate"
            ],
            "additionalProperties": false
          },
          "providerSummary": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mode": { "type": "string", "enum": ["relay", "official"] },
              "officialPresetId": { "type": ["string", "null"] },
              "officialPresetName": { "type": ["string", "null"] },
              "credentialConfigured": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "stale": { "type": "boolean" },
              "floatingVisible": { "type": "boolean" },
              "primaryMeter": {
                "anyOf": [{ "$ref": "#/$defs/meter" }, { "type": "null" }]
              },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              }
            },
            "required": [
              "id",
              "name",
              "mode",
              "officialPresetId",
              "officialPresetName",
              "credentialConfigured",
              "status",
              "checkedAt",
              "stale",
              "floatingVisible",
              "primaryMeter",
              "error"
            ],
            "additionalProperties": false
          },
          "statusCounts": {
            "type": "object",
            "properties": {
              "ok": { "type": "integer", "minimum": 0 },
              "error": { "type": "integer", "minimum": 0 },
              "unconfigured": { "type": "integer", "minimum": 0 },
              "unavailable": { "type": "integer", "minimum": 0 },
              "pending": { "type": "integer", "minimum": 0 }
            },
            "required": ["ok", "error", "unconfigured", "unavailable", "pending"],
            "additionalProperties": false
          },
          "unitTotal": {
            "type": "object",
            "properties": {
              "unit": { "type": "string" },
              "total": { "type": "number" }
            },
            "required": ["unit", "total"],
            "additionalProperties": false
          },
          "refreshOutcome": {
            "type": "object",
            "properties": {
              "providerId": { "type": "string" },
              "providerName": { "type": "string" },
              "success": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              }
            },
            "required": ["providerId", "providerName", "success", "status", "checkedAt", "error"],
            "additionalProperties": false
          },
          "refreshBatch": {
            "type": "object",
            "properties": {
              "scope": { "type": "string", "enum": ["due", "all", "selected"] },
              "requestedCount": { "type": "integer", "minimum": 0 },
              "successCount": { "type": "integer", "minimum": 0 },
              "failureCount": { "type": "integer", "minimum": 0 },
              "results": {
                "type": "array",
                "items": { "$ref": "#/$defs/refreshOutcome" }
              }
            },
            "required": ["scope", "requestedCount", "successCount", "failureCount", "results"],
            "additionalProperties": false
          }
        }
      }
    },
    "quota_provider_detail": {
      "description": "刷新指定站点并返回该站点的全部额度项。返回值经过脱敏，不包含 API Key、URL、请求配置或原始上游响应。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "required": ["providerId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generatedAt": { "type": "string" },
          "refresh": { "$ref": "#/$defs/refreshBatch" },
          "provider": { "$ref": "#/$defs/providerDetail" }
        },
        "required": ["generatedAt", "refresh", "provider"],
        "additionalProperties": false,
        "$defs": {
          "safeError": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing_credential",
                  "preset_unavailable",
                  "refresh_failed",
                  "not_checked",
                  "stale",
                  "low_remaining"
                ]
              },
              "message": { "type": "string" }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          },
          "meter": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["balance", "quota", "spend"] },
              "remaining": { "type": ["number", "null"] },
              "used": { "type": ["number", "null"] },
              "limit": { "type": ["number", "null"] },
              "unit": { "type": "string" },
              "resetAt": { "type": ["string", "null"] },
              "remainingPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "aggregate": { "type": "boolean" }
            },
            "required": [
              "id",
              "label",
              "kind",
              "remaining",
              "used",
              "limit",
              "unit",
              "resetAt",
              "remainingPercent",
              "aggregate"
            ],
            "additionalProperties": false
          },
          "providerDetail": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mode": { "type": "string", "enum": ["relay", "official"] },
              "officialPresetId": { "type": ["string", "null"] },
              "officialPresetName": { "type": ["string", "null"] },
              "credentialConfigured": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "stale": { "type": "boolean" },
              "floatingVisible": { "type": "boolean" },
              "primaryMeter": {
                "anyOf": [{ "$ref": "#/$defs/meter" }, { "type": "null" }]
              },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              },
              "meters": {
                "type": "array",
                "items": { "$ref": "#/$defs/meter" }
              }
            },
            "required": [
              "id",
              "name",
              "mode",
              "officialPresetId",
              "officialPresetName",
              "credentialConfigured",
              "status",
              "checkedAt",
              "stale",
              "floatingVisible",
              "primaryMeter",
              "error",
              "meters"
            ],
            "additionalProperties": false
          },
          "refreshOutcome": {
            "type": "object",
            "properties": {
              "providerId": { "type": "string" },
              "providerName": { "type": "string" },
              "success": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              }
            },
            "required": ["providerId", "providerName", "success", "status", "checkedAt", "error"],
            "additionalProperties": false
          },
          "refreshBatch": {
            "type": "object",
            "properties": {
              "scope": { "type": "string", "enum": ["due", "all", "selected"] },
              "requestedCount": { "type": "integer", "minimum": 0 },
              "successCount": { "type": "integer", "minimum": 0 },
              "failureCount": { "type": "integer", "minimum": 0 },
              "results": {
                "type": "array",
                "items": { "$ref": "#/$defs/refreshOutcome" }
              }
            },
            "required": ["scope", "requestedCount", "successCount", "failureCount", "results"],
            "additionalProperties": false
          }
        }
      }
    },
    "quota_refresh": {
      "description": "按 due、all 或 selected 范围刷新站点额度。selected 必须提供有效且不重复的 providerIds；返回逐站点成功或失败结果。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": { "type": "string", "enum": ["due", "all", "selected"] },
          "providerIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "required": ["scope"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generatedAt": { "type": "string" },
          "scope": { "type": "string", "enum": ["due", "all", "selected"] },
          "requestedCount": { "type": "integer", "minimum": 0 },
          "successCount": { "type": "integer", "minimum": 0 },
          "failureCount": { "type": "integer", "minimum": 0 },
          "results": {
            "type": "array",
            "items": { "$ref": "#/$defs/refreshOutcome" }
          }
        },
        "required": [
          "generatedAt",
          "scope",
          "requestedCount",
          "successCount",
          "failureCount",
          "results"
        ],
        "additionalProperties": false,
        "$defs": {
          "safeError": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing_credential",
                  "preset_unavailable",
                  "refresh_failed",
                  "not_checked",
                  "stale",
                  "low_remaining"
                ]
              },
              "message": { "type": "string" }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          },
          "refreshOutcome": {
            "type": "object",
            "properties": {
              "providerId": { "type": "string" },
              "providerName": { "type": "string" },
              "success": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              }
            },
            "required": ["providerId", "providerName", "success", "status", "checkedAt", "error"],
            "additionalProperties": false
          }
        }
      }
    },
    "quota_health_check": {
      "description": "刷新全部站点并检查缺少凭证、预设不可用、刷新失败、未查询、数据过期和低剩余比例。默认阈值为 20% 与 60 分钟。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "remainingPercentBelow": { "type": "number", "minimum": 0, "maximum": 100 },
          "staleAfterMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 525600 }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generatedAt": { "type": "string" },
          "thresholds": { "$ref": "#/$defs/thresholds" },
          "healthy": { "type": "boolean" },
          "issueCount": { "type": "integer", "minimum": 0 },
          "issues": {
            "type": "array",
            "items": { "$ref": "#/$defs/healthIssue" }
          },
          "providers": {
            "type": "array",
            "items": { "$ref": "#/$defs/providerSummary" }
          },
          "refresh": { "$ref": "#/$defs/refreshBatch" }
        },
        "required": [
          "generatedAt",
          "thresholds",
          "healthy",
          "issueCount",
          "issues",
          "providers",
          "refresh"
        ],
        "additionalProperties": false,
        "$defs": {
          "safeError": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "missing_credential",
                  "preset_unavailable",
                  "refresh_failed",
                  "not_checked",
                  "stale",
                  "low_remaining"
                ]
              },
              "message": { "type": "string" }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          },
          "meter": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["balance", "quota", "spend"] },
              "remaining": { "type": ["number", "null"] },
              "used": { "type": ["number", "null"] },
              "limit": { "type": ["number", "null"] },
              "unit": { "type": "string" },
              "resetAt": { "type": ["string", "null"] },
              "remainingPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "aggregate": { "type": "boolean" }
            },
            "required": [
              "id",
              "label",
              "kind",
              "remaining",
              "used",
              "limit",
              "unit",
              "resetAt",
              "remainingPercent",
              "aggregate"
            ],
            "additionalProperties": false
          },
          "providerSummary": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "mode": { "type": "string", "enum": ["relay", "official"] },
              "officialPresetId": { "type": ["string", "null"] },
              "officialPresetName": { "type": ["string", "null"] },
              "credentialConfigured": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "stale": { "type": "boolean" },
              "floatingVisible": { "type": "boolean" },
              "primaryMeter": {
                "anyOf": [{ "$ref": "#/$defs/meter" }, { "type": "null" }]
              },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              }
            },
            "required": [
              "id",
              "name",
              "mode",
              "officialPresetId",
              "officialPresetName",
              "credentialConfigured",
              "status",
              "checkedAt",
              "stale",
              "floatingVisible",
              "primaryMeter",
              "error"
            ],
            "additionalProperties": false
          },
          "thresholds": {
            "type": "object",
            "properties": {
              "remainingPercentBelow": { "type": "number", "minimum": 0, "maximum": 100 },
              "staleAfterMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 525600 }
            },
            "required": ["remainingPercentBelow", "staleAfterMinutes"],
            "additionalProperties": false
          },
          "healthIssue": {
            "type": "object",
            "properties": {
              "providerId": { "type": "string" },
              "providerName": { "type": "string" },
              "code": {
                "type": "string",
                "enum": [
                  "missing_credential",
                  "preset_unavailable",
                  "refresh_failed",
                  "not_checked",
                  "stale",
                  "low_remaining"
                ]
              },
              "severity": { "type": "string", "enum": ["error", "warning"] },
              "message": { "type": "string" },
              "meterId": { "type": ["string", "null"] },
              "meterLabel": { "type": ["string", "null"] },
              "remainingPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
            },
            "required": [
              "providerId",
              "providerName",
              "code",
              "severity",
              "message",
              "meterId",
              "meterLabel",
              "remainingPercent"
            ],
            "additionalProperties": false
          },
          "refreshOutcome": {
            "type": "object",
            "properties": {
              "providerId": { "type": "string" },
              "providerName": { "type": "string" },
              "success": { "type": "boolean" },
              "status": {
                "type": "string",
                "enum": ["ok", "error", "unconfigured", "unavailable", "pending"]
              },
              "checkedAt": { "type": ["string", "null"] },
              "error": {
                "anyOf": [{ "$ref": "#/$defs/safeError" }, { "type": "null" }]
              }
            },
            "required": ["providerId", "providerName", "success", "status", "checkedAt", "error"],
            "additionalProperties": false
          },
          "refreshBatch": {
            "type": "object",
            "properties": {
              "scope": { "type": "string", "enum": ["due", "all", "selected"] },
              "requestedCount": { "type": "integer", "minimum": 0 },
              "successCount": { "type": "integer", "minimum": 0 },
              "failureCount": { "type": "integer", "minimum": 0 },
              "results": {
                "type": "array",
                "items": { "$ref": "#/$defs/refreshOutcome" }
              }
            },
            "required": ["scope", "requestedCount", "successCount", "failureCount", "results"],
            "additionalProperties": false
          }
        }
      }
    },
    "quota_supported_platforms": {
      "description": "返回 Quota Dock 内置的官方预设平台及其安全摘要，可按类别筛选。此工具不读取凭证，也不会发起网络请求。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": { "type": "string", "enum": ["api", "plan", "admin"] }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generatedAt": { "type": "string" },
          "category": { "type": ["string", "null"], "enum": [null, "api", "plan", "admin"] },
          "platformCount": { "type": "integer", "minimum": 0 },
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "category": { "type": "string", "enum": ["api", "plan", "admin"] },
                "categoryLabel": { "type": "string" },
                "credentialLabel": { "type": "string" },
                "credentialHelp": { "type": "string" },
                "defaultUnit": { "type": "string" },
                "supportsManualLimit": { "type": "boolean" },
                "supportsCurrencyOverride": { "type": "boolean" }
              },
              "required": [
                "id",
                "name",
                "category",
                "categoryLabel",
                "credentialLabel",
                "credentialHelp",
                "defaultUnit",
                "supportsManualLimit",
                "supportsCurrencyOverride"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["generatedAt", "category", "platformCount", "platforms"],
        "additionalProperties": false
      }
    },
    "quota_floating_window": {
      "description": "打开或关闭 Quota Dock 桌面浮窗。关闭不存在的浮窗会按成功处理，并返回当前打开状态和站点展示配置。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["open", "close"] }
        },
        "required": ["action"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "isOpen": { "type": "boolean" },
          "providers": {
            "type": "array",
            "items": { "$ref": "#/$defs/floatingProvider" }
          }
        },
        "required": ["isOpen", "providers"],
        "additionalProperties": false,
        "$defs": {
          "floatingProvider": {
            "type": "object",
            "properties": {
              "providerId": { "type": "string" },
              "name": { "type": "string" },
              "visible": { "type": "boolean" }
            },
            "required": ["providerId", "name", "visible"],
            "additionalProperties": false
          }
        }
      }
    },
    "quota_set_floating_visibility": {
      "description": "设置指定站点是否显示在桌面浮窗中，保存后立即同步现有浮窗。返回当前浮窗状态和脱敏后的展示配置。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "visible": { "type": "boolean" }
        },
        "required": ["providerId", "visible"],
        "additionalProperties": false
      },
      "outputSchema": {
